# Store the real file outside Git, chmod 600. Never paste AppSecret into reports.
OURNOTES_QQ_APP_ID=123456789
OURNOTES_QQ_APP_SECRET=replace-with-your-app-secret
# Optional legacy/offline bundle; not used when DATA_URL is set.
# OURNOTES_QQ_BUNDLE=/srv/ournotes/qqbot/content/global-20260924-v1
OURNOTES_QQ_STATE=/var/lib/ournotes-qqbot
OURNOTES_QQ_PUBLIC_BASE_URL=https://bot.example.com
OURNOTES_QQ_API_BASE_URL=https://api.bot.qq.com
# Website and bot may be hosted independently. Queries use a local cache.
OURNOTES_QQ_DATA_URL=https://otonote.example.com/content/current.json
OURNOTES_QQ_REFRESH_SECONDS=600
# Linux package fonts-noto-cjk; omit to auto-detect on macOS/Linux.
OURNOTES_QQ_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
