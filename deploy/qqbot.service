[Unit]
Description=Our Notes official QQ image-query bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ournotes-qqbot
Group=ournotes-qqbot
WorkingDirectory=/srv/ournotes/app
EnvironmentFile=/etc/ournotes/qqbot.env
ExecStart=/srv/ournotes/qqbot-venv/bin/uvicorn backend.qqbot.app:create_app_from_environment --factory --host 127.0.0.1 --port 8091 --workers 1 --no-access-log
StateDirectory=ournotes-qqbot
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ournotes-qqbot
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
