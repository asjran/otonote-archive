# Copy to /etc/ournotes/query.env. Update only after the new image
# digest passes CI, a manual server smoke run, and the 2 vCPU / 2 GiB
# capacity gate from the implementation plan.

# ---- Image digest (REQUIRED) -----------------------------------------------
OURNOTES_QUERY_IMAGE=registry.example.com/otonote/ournotes-query@sha256:REPLACE_WITH_REAL_DIGEST

# ---- Container data root (REQUIRED) --------------------------------------
# Host paths are fixed by deploy/query.service bind mounts. The application
# must use the mount target inside the container, never the host path.
OURNOTES_DATA_ROOT=/data

# ---- Public HTTP listener (REQUIRED) ---------------------------------------
OURNOTES_QUERY_HOST=127.0.0.1
OURNOTES_QUERY_PORT=8090
OURNOTES_QUERY_ENABLED_ENVIRONMENTS=global-production
OURNOTES_QUERY_FRESHNESS_SECONDS=300
OURNOTES_QUERY_CACHE_CONTROL_MAX_AGE=30
