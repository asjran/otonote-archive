# Copy to /etc/ournotes/resource-worker.env. Update only after the new digest
# passes CI, ACR manifest inspection, and a manual server smoke run.
OURNOTES_WORKER_IMAGE=registry.example.com/otonote/ournotes-resource-worker@sha256:326d79b4dcc1d84e577e3a3447107d7012175994cf60257b42bf272fb902cbae

# The service unit uses these fixed host paths. They are documented here so
# provisioning can validate ownership before enabling the timer.
OURNOTES_DATA_ROOT=/srv/ournotes-data
OURNOTES_SITE_RELEASE_ROOT=/srv/ournotes-site
OURNOTES_SECRET_FILE=/etc/ournotes/resource-worker.secrets.env
