---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventArchive from "../../components/EventArchive.astro";
import { eventRecords, eventHref, eventIdentities, eventCards, eventArtworks } from "../../lib/event-pages";
import { eventCopy } from "../../lib/event-copy";
import { activeReleaseContext } from "../../lib/release-context";
const copy = eventCopy(activeReleaseContext.locale);
---
<BaseLayout title={copy.title} description={copy.intro}>
  <EventArchive archive={{ records: eventRecords, definitionCount: eventRecords.length }} locale={activeReleaseContext.locale} href={eventHref} artworks={eventArtworks} identities={eventIdentities} cards={eventCards} />
</BaseLayout>
