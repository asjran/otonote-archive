---
import { activeReleaseContext } from '../../../lib/release-context';
import { siteHref } from '../../../lib/site-context';
const href=(path:string)=>import.meta.env.BASE_URL==='/'?path:siteHref(path,activeReleaseContext);
// Old bookmarks now lead to the supported team tools instead of a dead-end page.
return Astro.redirect(href('/tools/deck-builder/'), 301);
