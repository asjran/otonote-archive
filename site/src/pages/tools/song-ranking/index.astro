---
import "../../../styles/tool-studio.css";
import ToolPageHeader from "../../../components/ToolPageHeader.astro";
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ScoringModelNotice from '../../../components/ScoringModelNotice.astro';
import { catalog } from '../../../lib/shared-catalog';
import {sharedSongRankings as rankings} from '../../../lib/shared-song-ranking-data';
import { RANKING_METRICS, rankSongRows } from '../../../lib/song-ranking-view.mjs';
import '../../../styles/song-ranking.css';
import { filterVisual } from '../../../lib/filter-visuals';
const charts = catalog.musicCharts;
const isEnglish = catalog.release.locale === 'en';
const metricLabels: Record<string, string> = {
  scoreMultiplier: 'Score multiplier', p10Score: 'P10 reference score', difficultyFactor: 'Difficulty multiplier',
  comboFactor: 'Weighted combo multiplier', skillMultiplier: 'Ordinary skill gain multiplier',
  gekisouMultiplier: 'Gekisou / ordinary score multiplier', rankingBonusShare: 'Gekisou placement bonus share'
};
const skillDurations = Array.from({length:41}, (_,i) => i / 2);
const artwork = rankings.artwork;
const data = JSON.stringify({ rankings, artwork }).replaceAll('<', '\\u003c');
const initial: Array<(typeof rankings.ordinary)[number] & {rank:number|null;efficiency:number|null}> = rankSongRows(rankings.ordinary);
const format = (n: number | null) => n == null ? '—' : n.toLocaleString('zh-CN', { maximumFractionDigits: 0 });
---
<BaseLayout title="歌曲排行榜">
<div class="tool-studio" data-tool-kind="song-ranking">
  <ToolPageHeader kind="song-ranking" title="歌曲排行榜" description="按技能组合与谱面时长，比较出分、效率和达档所需综合力。" meta="普通演出 / 激奏演出" />
  <div class="content-shell ranking-shell">
    <song-ranking class="song-ranking">

      <script is:inline type="application/json" data-ranking-data set:html={data}></script>
      <section class="ranking-board" aria-labelledby="ranking-title">
      <section class="ranking-setup ranking-mode-setup" aria-labelledby="ranking-mode-title">
        <header class="ranking-setup-heading"><h2 id="ranking-mode-title">模式与榜单</h2>
        <details class="ranking-method"><summary>排名口径 <span aria-hidden="true">ⓘ</span></summary><div class="ranking-method-body">
          <h2>同一条件下比较谱面</h2>
          <p>基准使用 100,000 综合力，五次 +100% 加分技能、每次 5 秒；AP、满生命、无辅助。普通基准已在发布数据时逐音符计算，打开即可比较。排除卡牌、属性及乐队适配差异，固定基准，不读取个人编成。</p>
          <p>激奏统一三段第一、零判定偏差、60 FPS，不加入卡牌专属激奏技能。LUCK 使用固定种子 20260927、2 批抽样，每个数据版本预先生成同一份结果；随机谱面为 240 个样本。结果稳定可复现，不是实战必然得分。</p>
          <p>每秒得分 = 当前条件得分 ÷ 所选时长。谱面时长从零点至最后事件；音频时长包含音频首尾。不含加载与结算时间；缺少时长不参与效率排名。</p>
          <p>转分倍率 = 基准得分 ÷ 100,000。难度倍率 = 1 +（等级 − 5）× 0.005。连击倍率按音符分值权重加权；技能倍率为普通得分相对无技能分的增益。各项均保留游戏计分中的取整，不能直接相乘还原总分。</p>
          <p>按原始数值排序，相同结果采用 1、1、3 并列名次。激奏样本极值不是理论极值，接近的随机谱面不代表确定强弱。此榜用于比较谱面，不是实战成绩或活动收益榜。达档综合力 = 目标分数线 × 基准综合力 ÷ 所选技能口径的基准得分，是近似反推；排名使用未舍入值，展示值向上取到千位。</p>
        </div></details>
        </header>
        <div class="ranking-setting-row"><span>演出模式</span><div class="ranking-mode" role="group" aria-label="演出模式"><button type="button" data-mode="ordinary" aria-pressed="true">普通演出</button><button type="button" data-mode="gekisou" aria-pressed="false">激奏演出</button></div></div>
        <div class="ranking-setting-row"><span>查看榜单</span><div class="ranking-board-tabs" role="group" aria-label="榜单"><button type="button" data-board="expectedScore" aria-pressed="true">出分榜</button><button type="button" data-board="efficiency" aria-pressed="false">效率榜</button><button type="button" data-board="requiredPower" aria-pressed="false">达档综合力</button></div></div>
      </section>
        <section class="ranking-setup ranking-song-setup" aria-labelledby="ranking-filter-title">
          <header class="ranking-setup-heading"><h3 id="ranking-filter-title">歌曲筛选</h3><button type="button" data-reset class="ranking-clear">清空筛选</button></header>
          <div class="ranking-filter-fields">
            <label class="ranking-setting-row"><span>搜索歌曲</span><input data-filter="query" type="search" placeholder="歌曲名或关键词" /></label>
            <label class="ranking-setting-row ranking-difficulty-options"><span>难度</span><select data-filter="difficulty" data-quick aria-label="难度"><option value="all">全部</option>{['easy','normal','hard','expert'].map(d => <option value={d} data-difficulty={d}>{d.toUpperCase()}</option>)}</select></label>
            <label class="ranking-setting-row ranking-band-options"><span>乐队</span><select data-filter="band" data-quick aria-label="乐队"><option value="all">全部</option>{catalog.bands.map(b => { const visual = filterVisual('band', String(b.masterId)); return <option value={b.id} data-icon={visual.icon} data-icon-only={visual.iconOnly ? 'true' : undefined} data-round={visual.round ? 'true' : undefined} title={b.displayName} aria-label={b.displayName}>{b.displayName}</option>; })}</select></label>
            <label class="ranking-setting-row"><span>最高等级</span><input data-filter="maxLevel" aria-label="最高等级" type="number" min="1" max="40" step="0.5" placeholder="不限" /></label>
            <label class="ranking-setting-row ranking-duration-options"><span>最长时长</span><select data-filter="maxSeconds" aria-label="最长时长"><option value="all">不限</option>{[90,100,110,120,150].map(seconds=><option value={seconds}>{isEnglish ? `≤ ${seconds} s` : `≤ ${seconds} 秒`}</option>)}</select></label>
          </div>
          <div class="ranking-filter-tags tool-options" data-ranking-filter-tags aria-label="已选筛选"></div>
        </section>
        <details class="ranking-setup ranking-calculation-setup" data-calculation-controls aria-labelledby="ranking-calculation-title">
          <summary class="ranking-calculation-summary" id="ranking-calculation-title"><strong>计算条件</strong><span data-calculation-profile>基准五技能</span></summary>
          <div class="ranking-calculation-body">
        <label class="ranking-setting-row"><span>其他排序</span><select data-metric data-quick aria-label="其他排序"><option value="">按当前榜单</option>{Object.entries(RANKING_METRICS).filter(([key]) => !['expectedScore','efficiency','minimumScore','maximumScore'].includes(key)).map(([key,label]) => <option value={key}>{isEnglish ? metricLabels[key] ?? label : label}</option>)}</select></label>
          <label class="ranking-setting-row"><span>效率时长</span><select data-duration aria-label="效率时长"><option value="chart">谱面时长</option><option value="audio">音频时长</option></select></label>
          <section class="ranking-profile-controls" data-profile-controls aria-label="歌曲技能条件">
            <label class="ranking-setting-row"><span>技能组合</span><select data-grade-profile aria-label="技能组合"><option value="benchmark">基准五技能</option><option value="none">无加分技能</option><option value="custom">我的五个技能</option></select></label>
            <p class="ranking-skill-summary" data-skill-summary role="status"></p>
            <div class="ranking-custom-skills" data-custom-skills hidden>
              <div class="ranking-skill-actions"><strong>五个技能分别发动一次</strong><button type="button" data-copy-skills>将技能 1 应用于全部</button></div>
              {Array.from({length:5},(_,i)=><fieldset data-skill-slot><legend>技能 {i+1}</legend><label>加分（%）<input data-skill-percent type="number" min="0" max="1000" step="1" value="100" /></label><label>持续时间<select data-skill-seconds>{skillDurations.map(seconds=><option value={seconds} selected={seconds===5}>{seconds} 秒</option>)}</select></label></fieldset>)}
              <p>填写技能的加分与时长即可；计算会遍历发动顺序。时长支持 0–20 秒，每档 0.5 秒。</p>
            </div>
          </section>
          <section class="ranking-replay-controls" data-replay-panel aria-label="逐谱精算">
            <div class="ranking-replay-intro"><strong>逐谱精算 <small>可选</small></strong><p data-replay-description>基准榜已预先逐音符计算，可直接使用。调整技能或帧率后，可对筛出的谱面重新计算。</p></div>
            <div class="ranking-replay-options">
              <label class="ranking-setting-row"><span>当前列表</span><select data-replay-method aria-label="当前列表"><option value="linear">全部筛选结果</option><option value="replay">已完成精算</option></select></label>
              <label class="ranking-setting-row"><span>理想帧率</span><select data-replay-fps aria-label="理想帧率"><option value="60">60 FPS</option><option value="120">120 FPS</option></select></label>
              <label class="ranking-setting-row"><span>计算范围</span><select data-replay-scope aria-label="计算范围"><option value="top">当前排序前 25 张</option><option value="all">当前筛选全部</option></select></label>
              <div class="ranking-replay-actions"><button type="button" data-replay-run>开始逐谱精算</button><button type="button" data-replay-cancel hidden>停止计算</button><span>只比较已完成的谱面，不代表全库名次</span></div>
            </div>
            <p data-replay-status role="status" aria-live="polite"></p>
            <details data-replay-errors hidden></details>
          </section>
          <section class="ranking-grade-controls" data-grade-controls hidden aria-label="达档比较条件">
            <label class="ranking-setting-row"><span>目标档位</span><select data-grade-target data-quick aria-label="目标档位">{['D','C','B','A','S','SS'].map((name,i)=><option value={i+2} selected={name==='A'}>{name}</option>)}</select></label>
            <label class="ranking-setting-row"><span>已有分数</span><input data-grade-score type="number" min="0" step="1" placeholder="可选，输入分数直接判档" /></label>
            <p>达档综合力由当前条件下的得分近似反推，数值越低，达到目标档位所需综合力越少。显示到千位，不是实打保底；真实技能、活动加成及逐音符取整仍会影响结果。</p>
          </section>
          <details class="ranking-skill-help"><summary>基准、快速估算与逐谱精算有什么区别？</summary><div>
            <p>普通基准：100,000 综合力、五次 +100% / 5 秒技能，已预先逐音符计算。无加分技能使用同一谱面的无技能基础分，两者打开即可比较。</p>
            <p>我的五个技能：先用技能窗口表快速估算，修改条件即可看结果。需要比较接近的候选时，再运行逐谱精算，逐个音符计算技能覆盖、浮点累积与取整，并遍历 120 种发动顺序。</p>
            <p>P10 是 120 种等可能顺序由低到高的第 12 个分数；范围反映技能顺序差异，不是实战保底。精算只对本次完成的谱面排名，可随时切回全部筛选结果。</p>
            <p>以上按 AP、满生命、无条件加分技能比较。激奏使用固定基准。需要真实卡牌技能、非 AP 判定或活动加成时，从歌曲明细进入队伍计算器。</p>
          </div></details>
          </div>
        </details>
        <header class="ranking-board-heading"><div><h2 id="ranking-title">比较结果 <span data-count>{charts.length} 张谱面</span></h2></div><p data-context role="status">统一曲库 · 固定基准</p></header>
        <div class="ranking-picks" data-picks aria-label="本次筛选的选曲推荐"></div>
        <div class="ranking-table-wrap"><table class="ranking-table"><caption class="ranking-sr-only">歌曲、难度及统一基准下的分数与效率</caption><thead><tr><th scope="col">#</th><th scope="col">歌曲 / 难度</th><th scope="col"><button type="button" data-sort="expectedScore">基准得分 ↓</button></th><th scope="col"><button type="button" data-sort="efficiency">每秒得分</button></th><th scope="col" data-factor-heading>{isEnglish ? metricLabels.scoreMultiplier : '转分倍率'}</th><th scope="col"><span class="ranking-sr-only">倍率明细</span></th></tr></thead><tbody data-rows>
          {initial.slice(0,25).map(row => <tr><td class="ranking-position">{row.rank}</td><td class="ranking-song"><div class="ranking-track"><img src={artwork[row.trackId]} alt="" width="48" height="48" loading="lazy" /><div><strong>{row.title}</strong><small>{row.difficulty.toUpperCase()} · Lv.{row.level} · {row.bandLabels.join(' / ')}</small></div></div></td><td>{format(row.expectedScore)}</td><td>{format(row.efficiency)}</td><td>{row.scoreMultiplier == null ? '—' : `${row.scoreMultiplier.toFixed(4)}×`}</td><td></td></tr>)}
        </tbody></table></div>
        <div class="ranking-empty" data-empty hidden><strong>这次没有找到匹配的谱面</strong><p>换个关键词，或放宽难度和乐队筛选。</p></div>
        <footer class="ranking-pagination"><span data-range>第 1–25 项</span><div><button type="button" data-prev aria-label="上一页">←</button><span data-page>1 / 14</span><button type="button" data-next aria-label="下一页">→</button></div></footer>
      </section>
      <details class="tool-help"><summary>估算范围与限制</summary><ScoringModelNotice /></details>
      <p class="ranking-footnote">蓝色看出分，紫色看效率。对比条以当前筛选中的最高值为满格。<span>统一曲库 · 理想演奏估算</span></p>
      <noscript>当前展示普通演出出分榜前 25 项；切换和筛选需要启用 JavaScript。</noscript>
    </song-ranking>
  </div>
</div>
</BaseLayout>
<script>import '../../../lib/song-ranking-ui.mjs';</script>
