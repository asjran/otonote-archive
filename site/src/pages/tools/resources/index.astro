---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolGlyph from '../../../components/ToolGlyph.astro';
import { activeReleaseContext } from '../../../lib/release-context';
import { siteHref } from '../../../lib/site-context';
const en = activeReleaseContext.locale === 'en';
const say = (zh: string, english: string) => en ? english : zh;
const href = (path: string) => import.meta.env.BASE_URL === '/' ? path : siteHref(path, activeReleaseContext);
const libraries = [
 {path:'/cards/members/',title:say('成员卡面','Member card art'),description:say('按角色与卡牌筛选，查看卡面和差分。','Browse members and card art variants.'),kind:'image'},
 {path:'/cards/supports/',title:say('留影','Snaps'),description:say('查找留影原画、登场角色和相关资料。','Find snap artwork, characters and details.'),kind:'image'},
 {path:'/stamps/',title:say('表情','Stamps'),description:say('按角色、乐队与表情类型筛选。','Filter by character, band and stamp type.'),kind:'image'},
 {path:'/profile-decorations/?category=stickers',title:say('名片贴纸','Profile stickers'),description:say('浏览贴纸，查看大图与下载已收录的图片。','Preview and download collected sticker images.'),kind:'image'},
 {path:'/profile-decorations/?category=backgrounds',title:say('名片背景','Profile backgrounds'),description:say('查找背景名称、角色或编号。','Find backgrounds by name, character or number.'),kind:'image'},
 {path:'/comics/',title:say('漫画','Comics'),description:say('按角色与乐队找到漫画，打开大图阅读。','Find comics by character or band and read at full size.'),kind:'image'},
 {path:'/music/bgm/',title:say('BGM 音乐库','BGM library'),description:say('按场景或音频标识查找，试听、循环与下载。','Find music by scene or audio identifier, listen, loop and download.'),kind:'audio'},
 {path:'/music/',title:say('歌曲音频与谱面','Songs and charts'),description:say('从曲目资料试听歌曲，打开谱面播放与分析。','Listen to songs and open their chart playback and analysis.'),kind:'audio'},
 {path:'/stories/',title:say('剧情文本','Story text'),description:say('从标题、角色或章节找到故事，搜索对白与制作摘录。','Find stories by title, character or chapter, then search dialogue or create excerpts.'),kind:'text'},
];
---
<BaseLayout title={say('素材与音频检索','Images and audio')}>
 <section class="resource-desk content-shell" data-resource-desk>
  <header><a href={href('/tools/')}>← {say('游戏工具','Game tools')}</a><p>OTONOTE / ARCHIVE FINDER</p><h1>{say('素材与音频检索','Images and audio')}</h1><p>{say('输入名称、角色或编号，选择资料库继续查找。图片预览、音频试听与下载沿用各资料页。','Enter a name, character or identifier, then choose a library. Preview, listen and download on its existing pages.')}</p></header>
  <form role="search"><label for="resource-query">{say('带入资料库的关键词','Search keyword')}</label><div><input id="resource-query" name="q" type="search" placeholder={say('如角色名、卡牌标题、BGM 标识','Character, card title or BGM identifier')} autocomplete="off" /><button type="reset">{say('清除','Clear')}</button></div></form>
  <p class="resource-query-status" data-resource-status role="status" data-empty={say('选择下方资料库浏览全部内容。','Choose a library to browse all content.')} data-query={say('下方入口将带入关键词：','The links below will search for: ')}>{say('选择下方资料库浏览全部内容。','Choose a library to browse all content.')}</p>
  <nav class="resource-grid" aria-label={say('选择素材资料库','Choose an archive')}>
   {libraries.map(item => <a href={href(item.path)} data-resource-link><span class="resource-type">{item.kind === 'image' ? say('图像','IMAGE') : item.kind === 'audio' ? say('音频','AUDIO') : say('文本','TEXT')}</span><h2>{item.title}<span aria-hidden="true">↗</span></h2><p>{item.description}</p></a>)}
  </nav>
  <aside><ToolGlyph kind="resources"/><p>{say('素材按现有资料分类收录。具体图片或音频的可用情况、下载方式，以打开后的资料页为准。','Resources follow the existing archive categories. Each library shows availability and download options for its images or audio.')}</p></aside>
 </section>
</BaseLayout>
<script>
 import { resourceSearchUrl } from '../../../lib/resource-search.mjs';
 const desk = document.querySelector<HTMLElement>('[data-resource-desk]');
 const form = desk?.querySelector('form');
 const input = form?.querySelector<HTMLInputElement>('input');
 const status = desk?.querySelector<HTMLElement>('[data-resource-status]');
 const links = [...(desk?.querySelectorAll<HTMLAnchorElement>('[data-resource-link]') ?? [])];
 const render = (save = true) => {
  if (!input || !status) return;
  links.forEach(link => { link.href = resourceSearchUrl(link.href, input.value).href; });
  status.textContent = input.value.trim() ? `${status.dataset.query}${input.value.trim()}` : status.dataset.empty ?? '';
  if (save) history.replaceState(history.state, '', resourceSearchUrl(location.href, input.value));
 };
 const restore = () => { if (input) input.value = new URLSearchParams(location.search).get('q') || ''; render(false); };
 form?.addEventListener('input', () => render());
 form?.addEventListener('submit', event => { event.preventDefault(); render(); links[0]?.focus(); });
 form?.addEventListener('reset', event => { event.preventDefault(); if (input) { input.value = ''; input.focus(); } render(); });
 window.addEventListener('popstate', restore);
 restore();
</script>
<style>
 .resource-desk { max-width:1120px; padding-block:36px 64px; }
 header>a { font-size:12px; color:var(--lacquer); }
 header>p:first-of-type { margin-top:24px; font:10px var(--font-mono); letter-spacing:.12em; color:var(--lacquer); }
 h1 { margin-block:12px; font-size:clamp(28px,4vw,42px); }
 header>p:last-child { max-width:720px; font-size:13px; line-height:1.9; color:var(--silver-dark); }
 form { margin-top:28px; max-width:680px; }
 form label { display:block; margin-bottom:9px; font-size:12px; font-weight:650; }
 form>div { display:flex; gap:10px; }
 input { flex:1; min-width:0; }
 input,button { min-height:44px; padding:10px 14px; border:1px solid var(--line); border-radius:9px; background:var(--paper-light); color:var(--ink); font:13px var(--font-body); }
 button { cursor:pointer; }
 .resource-query-status { font-size:12px; color:var(--silver-dark); margin-block:14px 22px; overflow-wrap:anywhere; }
 .resource-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
 .resource-grid a { padding:20px; border:1px solid var(--line); border-radius:14px; color:var(--ink); background:var(--paper-light); text-decoration:none; }
 .resource-grid a:hover { border-color:var(--lacquer); }
 .resource-type { font:10px var(--font-mono); color:var(--lacquer); letter-spacing:.1em; }
 .resource-grid h2 { display:flex; gap:12px; align-items:center; font-size:17px; margin:12px 0; }
 .resource-grid h2 span { margin-left:auto; font-weight:400; }
 .resource-grid p,aside p { color:var(--silver-dark); font-size:12px; line-height:1.8; margin:0; }
 aside { display:flex; align-items:center; gap:14px; margin-top:24px; padding:18px; border-top:1px solid var(--line); }
 aside :global(svg) { width:32px; flex-shrink:0; color:var(--lacquer); }
 :is(a,input,button):focus-visible { outline:2px solid var(--lacquer); outline-offset:4px; }
 @media(max-width:780px){.resource-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
 @media(max-width:480px){.resource-grid{grid-template-columns:1fr;}.resource-desk{padding-top:24px;}}
</style>
