---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterPanel from "../../components/FilterPanel.astro";
import PaginationControls from "../../components/PaginationControls.astro";
import { storyLibrary, storyCharacters, storyBands, storyCopy as copy, episodeLabel, storyKind, storyKindLabel, storyKinds } from "../../lib/story-library";
import { activeReleaseContext } from "../../lib/release-context";
import { siteHref } from "../../lib/site-context";
import { catalog, getAsset } from "../../lib/catalog";
import { storyAvatar, storyCharacter } from "../../lib/story-avatars";
import "../../styles/story-text.css";
const href = (path: string) => import.meta.env.BASE_URL === "/" ? path : siteHref(path, activeReleaseContext);
const hints = { main: copy.mainHint, extra: copy.extraHint, viewpoint: copy.viewpointHint, friendship: copy.friendshipHint };
const bandDetails = new Map(catalog.bands.map(band => [band.masterId, band]));
---
<BaseLayout title={copy.title} description={copy.intro}>
  <div class="st-library content-shell" data-story-library data-filter-scope>
    <header class="st-heading">
      <div><p class="st-eyebrow">OTONOTE / STORY COLLECTION</p><h1>{copy.title}</h1><p class="st-intro">{copy.intro}</p></div>
    </header>
    {!storyLibrary.entries.length ? <p class="st-empty">{copy.unavailable}</p> : <>
      <nav class="st-categories" aria-label={copy.category}>
        {storyKinds.map(kind => <a href={`?category=${kind}`} data-story-category={kind} data-kind={kind}>
          <div class="st-category-top"><span class="st-category-symbol" aria-hidden="true">{kind === "main" ? "♫" : kind === "extra" ? "✦" : kind === "viewpoint" ? "◈" : "♡"}</span><span class="st-category-count">{storyLibrary.entries.filter(e => storyKind(e) === kind).length} <small>{copy.results}</small></span></div>
          <h2>{storyKindLabel(kind)}</h2><p>{hints[kind]}</p>
        </a>)}
      </nav>
      <div class="st-band-shelf" role="group" aria-label={copy.bandFilter}>
        <span class="st-shelf-label">{copy.bandFilter}</span>
        {storyLibrary.bands.map(band => {
          const detail = bandDetails.get(band.id);
          const logo = getAsset(detail?.logoAssetId);
          return <button type="button" data-story-band={band.id} aria-pressed="false" aria-label={band.name} title={band.name} style={`--band-accent:${detail?.mainColor || "var(--lacquer)"}`}>
            {logo ? <img src={logo.thumbnailUrl || logo.previewUrl} alt={band.name} width="100" height="40" /> : <span>{band.name}</span>}
          </button>;
        })}
      </div>
      <form class="st-filters" data-library-form>
        <label class="st-search"><span class="visually-hidden">{copy.search}</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input type="search" name="q" placeholder={copy.search} autocomplete="off" /></label>
        <FilterPanel drawer title={copy.title} count={storyLibrary.entries.length} noun={copy.results}><div class="st-filter-groups">
          <label><span>{copy.category}</span><select name="category" multiple data-inline-filter><option value="all">{copy.all}</option>{storyKinds.map(kind => <option value={kind}>{storyKindLabel(kind)}</option>)}</select></label>
          <label><span>{copy.bandFilter}</span><select name="band" multiple data-inline-filter><option value="all">{copy.allBands}</option>{storyLibrary.bands.map(band => <option value={band.id}>{band.name}</option>)}</select></label>
          <label><span>{copy.character}</span><select name="character" multiple data-inline-filter><option value="all">{copy.allCharacters}</option>{storyLibrary.characters.map(character => <option value={character.id}>{character.name}</option>)}</select></label>
        </div></FilterPanel>
      </form>
      <div class="st-results"><div><a class="st-all" href="?" data-story-category="all">{copy.all}</a><span aria-live="polite"><b data-library-count data-filter-count>{storyLibrary.entries.length}</b> {copy.results}</span></div><button type="button" data-library-clear data-filter-reset>{copy.clear}</button></div>
      <div class="st-cards">
        {storyLibrary.entries.map(entry => {
          const characters = entry.characterIds.map(id => storyCharacters.get(id)).filter(Boolean).join(" / ");
          const bands = entry.bandIds.map(id => storyBands.get(id)).filter(Boolean).join(" / ");
          const kind = storyKind(entry);
          const band = bandDetails.get(entry.bandIds[0]);
          return <article class="st-card" data-story-card data-id={entry.id} data-category={kind} data-kind={kind}
            data-band={entry.bandIds.join(",")} data-character={entry.characterIds.join(",")}
            style={`--band-accent:${band?.mainColor || "var(--lacquer)"}`}
            data-search={`${entry.title} ${entry.chapterName} ${characters} ${bands} ${episodeLabel(entry)}`}>
            <a href={href(`/stories/episodes/${entry.id}/`)}>
              <div class="st-card-meta"><span class="st-tag" data-kind={kind}>{storyKindLabel(kind)}</span><span class="st-episode-label">{episodeLabel(entry)}</span></div>
              <div class="st-card-body"><p class="st-chapter-name">{entry.category === "friendship" ? characters : entry.chapterName}</p><h3>{entry.title || episodeLabel(entry)}</h3>
                {entry.category === "viewpoint" ? <p class="st-viewpoint-name">{characters}</p> : entry.description && <p class="st-card-excerpt">{entry.description}</p>}
              </div>
              <div class="st-card-cast"><div class="st-cast" aria-hidden="true">{entry.characterIds.slice(0,5).map(id => {const character = storyCharacter(id); const avatar = storyAvatar(character); return <span>{avatar ? <img src={avatar.thumbnailUrl || avatar.previewUrl} alt="" loading="lazy" width="32" height="32" /> : character?.shortName}</span>;})}</div><span>{bands}</span></div>
              <div class="st-card-footer"><span>{entry.lineCount} {copy.lines}</span><span class="st-read-link">{copy.read}</span></div>
            </a>
          </article>;
        })}
      </div>
      <div class="st-empty" data-library-empty hidden><span aria-hidden="true">⌕</span><h2>{copy.noResults}</h2><p>{copy.tryAgain}</p><button type="button" data-library-clear>{copy.clear}</button></div>
      <PaginationControls defaultPageSize={24} />
    </>}
  </div>
</BaseLayout>
<script>
  import { restoreFilterControl, selectedControlValues, matchesFilter } from "../../lib/filter-controls.mjs";
  import { createPaginationAdapter } from "../../lib/pagination-browser.mjs";
  const library = document.querySelector<HTMLElement>("[data-story-library]");
  const form = library?.querySelector<HTMLFormElement>("[data-library-form]");
  if (library && form) {
    const cards = Array.from(library.querySelectorAll<HTMLElement>("[data-story-card]"));
    const fields = ["q", "category", "band", "character"];
    const controls = fields.map(name => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement);
    const restore = () => { const params = new URLSearchParams(location.search); form.reset();
      controls.forEach(control => { const value = params.get(control.name); if (value) restoreFilterControl(control, control.name === "category" ? value.split(",").flatMap(item => item === "band" ? ["main", "extra"] : [item]).join(",") : value); }); };
    restore();
    let pagination: ReturnType<typeof createPaginationAdapter> = null;
    const update = (reset = false, mode: "replace" | "push" | "none" = "replace") => {
      if (reset) pagination?.reset();
      const params = new URLSearchParams();
      controls.forEach(c => { const value = c instanceof HTMLSelectElement ? selectedControlValues(c).join(",") : c.value; if (value && value !== "all") params.set(c.name, value); });
      const query = (params.get("q") || "").trim().toLocaleLowerCase();
      const visible = cards.filter(card => (!query || (card.dataset.search || "").toLocaleLowerCase().includes(query))
        && ["category", "band", "character"].every(key => matchesFilter((card.dataset[key] || "").split(","), params.get(key))));
      const page = pagination?.paginate(visible);
      const shown = new Set(page?.records ?? visible);
      cards.forEach(card => { card.hidden = !shown.has(card); });
      const count = library.querySelector("[data-library-count]"); if (count) count.textContent = String(visible.length);
      const empty = library.querySelector<HTMLElement>("[data-library-empty]"); if (empty) empty.hidden = visible.length > 0;
      library.querySelectorAll<HTMLElement>("[data-story-category]").forEach(link => {
        if (link.dataset.storyCategory === "all" ? !params.has("category") : (params.get("category") || "").split(",").includes(link.dataset.storyCategory!)) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
      library.querySelectorAll<HTMLElement>("[data-story-band]").forEach(link => {
        const selected = (params.get("band") || "").split(",").includes(link.dataset.storyBand!);
        link.toggleAttribute("data-active", selected);
        link.setAttribute("aria-pressed", String(selected));
      });
      document.dispatchEvent(new Event("filter-controls-sync"));
      if (page) pagination?.render(page);
      const next = pagination?.params(params) ?? params;
      if (mode !== "none") history[mode === "push" ? "pushState" : "replaceState"](null, "", `${location.pathname}${next.size ? `?${next}` : ""}`);
    };
    pagination = createPaginationAdapter(library, { onChange: (mode: "replace" | "push") => update(false, mode) });
    form.addEventListener("submit", event => event.preventDefault());
    form.addEventListener("input", () => update(true));
    form.addEventListener("change", () => update(true));
    library.querySelectorAll<HTMLAnchorElement>("[data-story-category]").forEach(link => link.addEventListener("click", event => {
      event.preventDefault(); (form.elements.namedItem("category") as HTMLSelectElement).value = link.dataset.storyCategory!; update(true, "push");
    }));
    library.querySelectorAll<HTMLButtonElement>("[data-story-band]").forEach(button => button.addEventListener("click", () => {
      const control = form.elements.namedItem("band") as HTMLSelectElement;
      control.value = selectedControlValues(control).includes(button.dataset.storyBand!) ? "all" : button.dataset.storyBand!;
      update(true, "push");
    }));
    library.querySelectorAll("[data-library-clear]").forEach(button => button.addEventListener("click", () => { form.reset(); update(true); }));
    window.addEventListener("popstate", () => { restore(); pagination?.restore(new URLSearchParams(location.search)); update(false, "none"); });
    update();
  }
</script>
