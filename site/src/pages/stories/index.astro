---
import {activeReleaseContext} from '../../lib/release-context';
import {siteHref} from '../../lib/site-context';
const category = Astro.url.searchParams.get('category');
const section = ['main','extra','viewpoint','friendship','event'].includes(category ?? '') ? category : 'main';
const path = `/stories/${section === 'event' ? 'events' : section}/`;
const destination = import.meta.env.BASE_URL === '/' ? path : siteHref(path, activeReleaseContext);
const params = new URLSearchParams(Astro.url.search);
params.delete('category');
return Astro.redirect(destination + (params.size ? `?${params}` : '') + Astro.url.hash, 301);
---
