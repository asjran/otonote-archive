---
import FilterPanel from "../FilterPanel.astro";
import { say, categories } from "../../lib/system-display";
interface Props { count: number; categoryKeys?: string[]; cards?: boolean; placeholder?: string; }
const { count, categoryKeys = [], cards, placeholder = say("搜索名称或奖励…", "Search names or rewards…") } = Astro.props;
---
<div class="filter-toolbar">
  <label class="search-control sys-search"><span class="visually-hidden">{say("搜索", "Search")}</span><input type="search" data-filter="query" placeholder={placeholder} /></label>
<FilterPanel drawer count={count} noun={say("项", "results")} title={say("筛选", "Filters")} hint={say("组合条件，缩小浏览范围", "Combine filters to narrow results")}>
  <div class="sys-filters">
    {categoryKeys.length > 0 && <label>{say("分类", "Category")}<select data-filter="category"><option value="">{say("全部分类", "All categories")}</option>{categoryKeys.map(key => <option value={key}>{categories[key] || key}</option>)}</select></label>}
    {cards && <><label>{say("卡片类型", "Card type")}<select data-filter="kind"><option value="">{say("全部", "All")}</option><option value="2">{say("成员卡", "Members")}</option><option value="3">{say("留影", "Snapshots")}</option><option value="1">{say("道具", "Items")}</option></select></label>
      <label>{say("稀有度", "Rarity")}<select data-filter="rarity"><option value="">{say("全部", "All")}</option>{["R", "SR", "SSR", "BD", "EX"].map(r => <option value={r}>{r}</option>)}</select></label></>}
  </div>
</FilterPanel>
</div>
<div class="sys-result-bar"><p class="sys-result-count" role="status">{say("找到", "Found")} <strong data-count data-filter-count>{count}</strong> {say("项", "results")}</p><button type="button" data-reset data-filter-reset>{say("重置", "Reset")}</button></div>
