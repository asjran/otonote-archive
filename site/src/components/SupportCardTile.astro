---
import {
  getAsset,
  getBand,
  getCharacter,
  type SupportCard
} from "../lib/catalog";
import { activeReleaseContext } from "../lib/release-context";
import { siteHref } from "../lib/site-context";
import { getUi } from "../lib/ui-i18n";
import { classifyTileTitleDensity } from "../lib/tile-title-density.mjs";
import "../styles/faceted-browser.css";
import ArchiveImage from "./ArchiveImage.astro";
import CardAttributeBadge from "./CardAttributeBadge.astro";
import CardRarityBadge from "./CardRarityBadge.astro";
import BandMark from "./BandMark.astro";
import StatusTag from "./StatusTag.astro";

interface Props {
  card: SupportCard;
  skillFacets?: Record<string, string[]>;
}

const { card, skillFacets = {} } = Astro.props;
const ui = getUi(activeReleaseContext.locale);
const asset = getAsset(card.thumbnailAssetId);
const characters = card.featuredCharacterIds
  .map(getCharacter)
  .filter((character) => character !== undefined);
const characterNames = characters
  .map((character) => character.displayName)
  .join("、");
const bands = [
  ...new Map(
    characters
      .map((character) => getBand(character.bandId))
      .filter((band) => band !== undefined)
      .map((band) => [band.id, band])
  ).values()
];
const localizedHref = (logicalPath: string) =>
  import.meta.env.BASE_URL === "/"
    ? logicalPath
    : siteHref(logicalPath, activeReleaseContext);
const href = localizedHref(`/cards/supports/${card.id}/`);
const title = card.description || card.name;
const titleDensity = classifyTileTitleDensity(title);
---

<article
  class:list={[
    "catalog-tile",
    "card-tile",
    "support-card-tile",
    "compact-catalog-tile",
    "catalog-item",
    `tile-title-${titleDensity}`
  ]}
  data-search={`${card.displayName} ${card.name} ${card.description} ${card.masterId} ${characters.flatMap((character) => [character.displayName, ...character.aliases]).join(" ")}`}
  data-skill-role={skillFacets["skill-role"]?.join(",")}
  data-gekisou-type={skillFacets["gekisou-type"]?.join(",")}
  data-gekisou-effect={skillFacets["gekisou-effect"]?.join(",")}
  data-status={card.catalogStatus}
  data-rarity={String(card.rarity)}
  data-attribute={String(card.attributeCode)}
  data-character={card.featuredCharacterIds.join(",")}
  data-band={bands.map((band) => band.id).join(",")}
  data-label={card.masterId.toString().padStart(6, "0")}
  data-card-kind="support"
>
  <a class="tile-media support-media" href={href} data-media-ratio="16:9">
    {asset ? (
      <ArchiveImage
        class="image-fit--support"
        asset={asset}
        alt={`${card.displayName} ${ui.supportCard}`}
        controlledLazy
      />
    ) : (
      <span class="media-missing">{ui.previewPending}</span>
    )}
    <span class="archive-index">SC-{card.masterId.toString().padStart(3, "0")}</span>
  </a>
  <div class="tile-body">
    <StatusTag status={card.catalogStatus} dotOnly />
    <div class="tile-icon-row">
      <span class="card-taxonomy-line">
        <CardRarityBadge rarity={card.rarity} compact />
        <CardAttributeBadge code={card.attributeCode} compact />
      </span>
    </div>
    <h2><a href={href}>{title}</a></h2>
    <p>
      <span title={characterNames || ui.relationPending}>
        {characterNames || ui.relationPending}
      </span>
      <span class="card-band-logos">{bands.map((band) => <BandMark band={band} compact iconOnly />)}</span>
    </p>
  </div>
</article>
