---
import { activeReleaseContext } from "../lib/release-context";
const english = activeReleaseContext.locale === "en";
---
<section class="tool-capability" data-scoring-unavailable>
  <h2>{english ? "Calculation data unavailable" : "计算数据暂不可用"}</h2>
  <p>{english
    ? "Calculation inputs are missing or incompatible. Card, song and story data remain available."
    : "当前计算数据缺失或格式不兼容。卡牌、歌曲和剧情资料可正常浏览。"}</p>
  <a href="/">{english ? "Browse the updated archive" : "浏览最新资料"}</a>
</section>
