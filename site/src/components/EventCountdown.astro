---
import { eventTimestamp, eventCountdown } from '../lib/event-time.mjs';
import { eventCountdownInitScript } from '../lib/event-countdown-client.mjs';
import EventIcon from './EventIcon.astro';
interface Props { start: string | null; end: string | null; edition: string; timeZone?: string | null; locale?: string }
const { start, end, edition, timeZone, locale = 'zh-CN' } = Astro.props;
const startMs = eventTimestamp(start, edition, timeZone), endMs = eventTimestamp(end, edition, timeZone);
const note = timeZone ?? (edition === 'jp' ? 'JST (UTC+9)' : 'UTC+8');
const initial = eventCountdown(startMs, endMs, Date.now(), locale === 'en');
---
<span class="ef-countdown" data-event-countdown data-start={startMs} data-end={endMs} data-en={locale === 'en'} data-state={initial.state} title={note}><EventIcon name="clock" size={14} /><span>{initial.label}</span></span><script is:inline data-event-countdown-init set:html={eventCountdownInitScript()} />
<script>
  import { eventCountdown } from '../lib/event-time.mjs';
  import { refreshEventCountdown } from '../lib/event-countdown-client.mjs';
  const refresh = () => document.querySelectorAll<HTMLElement>('[data-event-countdown]').forEach(node => {
    refreshEventCountdown(node, eventCountdown);
  });
  let timer: ReturnType<typeof setInterval>;
  const start = () => {
    refresh();
    clearInterval(timer);
    timer = window.setInterval(refresh, 30000);
    document.addEventListener('visibilitychange', refresh);
  };
  start();
  window.addEventListener('pageshow', start);
  window.addEventListener('pagehide', () => { clearInterval(timer); document.removeEventListener('visibilitychange', refresh); });
</script>
