---
import { databaseHref, say } from "../../lib/database-display";
import "../../styles/database-dialog.css";
interface Props { kind: "skills" | "items" }
const { kind } = Astro.props;
---
<database-detail-dialog data-detail-base={databaseHref(`/database/details/${kind}/`)}>
  <dialog class="db-detail-dialog" aria-label={say("资料详情", "Details")}>
    <div class="db-dialog-bar">
      <span>{kind === "skills" ? say("技能资料", "Skill details") : say("道具资料", "Item details")}</span>
      <button type="button" data-db-close aria-label={say("关闭详情", "Close details")} autofocus>×</button>
    </div>
    <div data-db-content aria-live="polite"></div>
    <p data-db-loading hidden>{say("正在加载…", "Loading…")}</p>
    <div data-db-error hidden><p>{say("暂时无法加载详情，请重试。", "Unable to load details. Please try again.")}</p><button type="button" data-db-retry>{say("重试", "Retry")}</button></div>
  </dialog>
</database-detail-dialog>
<script>
  import "../../lib/database-detail-dialog.mjs";
</script>
