/analysis/*
!/analysis/*.py
!/analysis/*.md
!/analysis/*.json
!/analysis/requirements.txt
!/analysis/crypto/
/analysis/crypto/*
!/analysis/crypto/*.py
!/analysis/crypto/*.md
!/analysis/crypto/requirements.txt

# Site dependencies and build artifacts
/site/node_modules/
/site/dist/
/site/dist-matrix/
/site/.astro/
/site/.playwright-cli/
/site/output/
/site/public/media/
/site/public/live2d/
