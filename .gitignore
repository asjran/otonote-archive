.DS_Store
.superpowers/
/.astro/
/outputs/

# Local environment files; examples remain publishable.
.env
.env.*
!.env.example
!.env.*.example

# Original packages and extracted runtime data
*.apk
*.zip
/files/
/input/
/アワーノーツ/

