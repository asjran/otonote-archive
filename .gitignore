# Catalog build products
/catalog/generated/
/catalog/site-data/

# Resource platform runtime data and local secrets
/data/
/config/environments/*.local.toml
/config/server-sync.local.toml
*.secret
*.credentials
/deploy/qqbot.env copy.example

# Local caches
/.playwright-cli/
/output/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# Private inputs and third-party content are never source publications.
/node_modules/
/site/src/data/
